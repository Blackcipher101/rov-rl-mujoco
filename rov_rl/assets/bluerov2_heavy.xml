<!--
  BlueROV2-Heavy-like ROV for MuJoCo / MJX. Primitive geoms only (no CAD).

  Parameters: von Benzon et al., J. Mar. Sci. Eng. 10(12):1898, 2022 (Table A1),
  converted to MuJoCo FLU body frame (x fwd, y left, z up). See rov_rl/vehicle.py.

  Hydrodynamics (see scripts/derive_hydro_params.py):
    * MuJoCo built-in fluid model, inertia-box variant (the only variant MJX's
      JAX backend implements). geoms carry NO fluidshape on purpose:
      tests/test_fluid.py asserts this so CPU and MJX stay identical.
    * density = 1000 kg/m^3 (water). viscosity = effective eddy viscosity
      [Pa s] fitted to identified linear surge damping, NOT molecular viscosity.
    * option/wind = water-current velocity in the world frame [m/s]; MuJoCo
      subtracts it from body velocity inside the fluid model. Set at runtime.
    * The body "hydro_proxy" is a light welded child whose inertia box makes
      the summed quadratic drag match identified X|u|, Y|v|, Z|w|.
  Buoyancy is NOT part of MuJoCo's fluid model; it is applied at runtime as an
  explicit world-frame force at the centre of buoyancy via xfrc_applied
  (rov_rl/core.py::buoyancy_wrench).
-->
<mujoco model="bluerov2_heavy_like">
  <compiler angle="radian" fusestatic="false" inertiafromgeom="auto"/>

  <option timestep="0.004" integrator="Euler" density="1000" viscosity="1.7068" wind="0 0 0">
    <flag contact="disable"/>
  </option>

  <!-- extent = 1 so that visual/map distances below read as metres. -->
  <statistic extent="1" center="0 0 0"/>

  <visual>
    <global offwidth="1280" offheight="720" fovy="60"/>
    <quality shadowsize="0"/>
    <map znear="0.01" zfar="40" fogstart="1.5" fogend="14.0" haze="0.5"/>
    <rgba fog="0.03 0.20 0.28 1" haze="0.05 0.28 0.36 1"/>
    <headlight ambient="0.30 0.40 0.45" diffuse="0.45 0.55 0.60" specular="0.05 0.05 0.05"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.08 0.38 0.50" rgb2="0.00 0.04 0.08" width="256" height="256"/>
    <texture name="seabed" type="2d" builtin="checker" rgb1="0.30 0.32 0.26" rgb2="0.24 0.26 0.21" width="512" height="512" mark="random" random="0.05" markrgb="0.40 0.42 0.35"/>
    <material name="seabed" texture="seabed" texrepeat="40 40" reflectance="0"/>
    <material name="frame" rgba="0.08 0.08 0.09 1"/>
    <material name="foam" rgba="0.10 0.25 0.55 1"/>
    <material name="tube" rgba="0.75 0.80 0.85 0.6"/>
    <material name="battery" rgba="0.55 0.58 0.60 1"/>
    <material name="thruster" rgba="0.12 0.12 0.14 1"/>
    <material name="dome" rgba="0.6 0.8 0.9 0.35"/>
  </asset>

  <default>
    <geom contype="0" conaffinity="0" group="1"/>
    <site group="3" size="0.01" rgba="1 0.3 0.1 1"/>
    <general dyntype="filter" dynprm="0.0287" gaintype="fixed" gainprm="1" biastype="none"
             ctrllimited="true" ctrlrange="-30.4 30.4" gear="0 0 1 0 0 0"/>
  </default>

  <worldbody>
    <light name="sun" directional="true" pos="0 0 10" dir="0 0 -1" diffuse="0.35 0.45 0.5" specular="0 0 0"/>
    <!-- Visual-only seabed, 6 m below the start depth (no contacts are simulated). -->
    <geom name="seabed" type="plane" pos="0 0 -6" size="60 60 0.1" material="seabed" group="0"/>

    <body name="rov" pos="0 0 0">
      <freejoint name="root"/>
      <!-- Hull: total 13.5 kg / CAD inertia minus the hydro proxy below. -->
      <inertial pos="0 0 0" mass="13.25" diaginertia="0.251246 0.215278 0.359125"/>

      <camera name="chase" mode="fixed" pos="-1.3 0 0.45" xyaxes="0 -1 0 0.35 0 1" fovy="60"/>

      <!-- Visual primitives (approximate envelope 0.46 x 0.58 x 0.38 m, [vB22] Table 5). -->
      <geom name="plate_left" type="box" pos="0 0.17 0" size="0.23 0.006 0.12" material="frame"/>
      <geom name="plate_right" type="box" pos="0 -0.17 0" size="0.23 0.006 0.12" material="frame"/>
      <geom name="wing_left" type="box" pos="0 0.218 0.0" size="0.17 0.05 0.006" material="frame"/>
      <geom name="wing_right" type="box" pos="0 -0.218 0.0" size="0.17 0.05 0.006" material="frame"/>
      <geom name="foam" type="box" pos="0 0 0.10" size="0.20 0.16 0.04" material="foam"/>
      <geom name="electronics_tube" type="cylinder" fromto="-0.16 0 0.01 0.16 0 0.01" size="0.05" material="tube"/>
      <geom name="dome" type="sphere" pos="0.16 0 0.01" size="0.05" material="dome"/>
      <geom name="battery_tube" type="cylinder" fromto="-0.14 0 -0.09 0.10 0 -0.09" size="0.035" material="battery"/>

      <!-- Thrusters: site +z = positive thrust direction ([vB22] Table A1, beta3 corrected). -->
      <site name="thruster1" pos="0.1560 -0.1110 -0.0850" zaxis="0.7071 0.7071 0"/>
      <site name="thruster2" pos="0.1564 0.1104 -0.0850" zaxis="0.7071 -0.7071 0"/>
      <site name="thruster3" pos="-0.1566 -0.1102 -0.0850" zaxis="-0.7071 0.7071 0"/>
      <site name="thruster4" pos="-0.1560 0.1110 -0.0850" zaxis="-0.7071 -0.7071 0"/>
      <site name="thruster5" pos="0.1200 -0.2180 0" zaxis="0 0 1"/>
      <site name="thruster6" pos="0.1204 0.2178 0" zaxis="0 0 1"/>
      <site name="thruster7" pos="-0.1208 -0.2176 0" zaxis="0 0 1"/>
      <site name="thruster8" pos="-0.1200 0.2180 0" zaxis="0 0 1"/>
      <geom name="thr1" type="cylinder" pos="0.1560 -0.1110 -0.0850" zaxis="0.7071 0.7071 0" size="0.045 0.035" material="thruster"/>
      <geom name="thr2" type="cylinder" pos="0.1564 0.1104 -0.0850" zaxis="0.7071 -0.7071 0" size="0.045 0.035" material="thruster"/>
      <geom name="thr3" type="cylinder" pos="-0.1566 -0.1102 -0.0850" zaxis="-0.7071 0.7071 0" size="0.045 0.035" material="thruster"/>
      <geom name="thr4" type="cylinder" pos="-0.1560 0.1110 -0.0850" zaxis="-0.7071 -0.7071 0" size="0.045 0.035" material="thruster"/>
      <geom name="thr5" type="cylinder" pos="0.1200 -0.2180 0" size="0.045 0.035" material="thruster"/>
      <geom name="thr6" type="cylinder" pos="0.1204 0.2178 0" size="0.045 0.035" material="thruster"/>
      <geom name="thr7" type="cylinder" pos="-0.1208 -0.2176 0" size="0.045 0.035" material="thruster"/>
      <geom name="thr8" type="cylinder" pos="-0.1200 0.2180 0" size="0.045 0.035" material="thruster"/>

      <!-- Welded hydrodynamic proxy (no geoms): its inertia box adds drag only. -->
      <body name="hydro_proxy" pos="0 0 0">
        <inertial pos="0 0 0" mass="0.25" diaginertia="0.008754 0.014722 0.010875"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general name="t1" site="thruster1"/>
    <general name="t2" site="thruster2"/>
    <general name="t3" site="thruster3"/>
    <general name="t4" site="thruster4"/>
    <general name="t5" site="thruster5"/>
    <general name="t6" site="thruster6"/>
    <general name="t7" site="thruster7"/>
    <general name="t8" site="thruster8"/>
  </actuator>
</mujoco>
